# Get a key from Google AI Studio (https://aistudio.google.com/apikey) for
# quick prototyping, or Google Cloud / Vertex AI if you want enterprise
# billing. Enable the Gemini API / Live API for the key's project.
GEMINI_API_KEY=

# Optional overrides — defaults are set in src/geminiSession.ts. Only
# change these if your key doesn't have access to the default model, or you
# want a different voice. Available live-capable models vary per key/project
# — find yours by running (from backend/, with GEMINI_API_KEY already set):
#
#   node -e "
#   const { GoogleGenAI } = require('@google/genai');
#   require('dotenv').config();
#   const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY, apiVersion: 'v1alpha' });
#   (async () => {
#     for await (const m of await ai.models.list()) {
#       if (m.supportedActions?.includes('bidiGenerateContent')) console.log(m.name);
#     }
#   })();
#   "
#
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE=Aoede

PORT=8081
